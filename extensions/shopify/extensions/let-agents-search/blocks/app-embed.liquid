{% comment %}
  Lets Search, the drawer, on every page of the store, once the merchant switches this app embed on.
  It is the only Let Agents script on the storefront: search, "about this product" on product pages,
  answers, the wishlist and shared links all come from {api}/search/lets-search.js, which carries its
  own styles and search engine. (The product-page block that loaded let-agents.js is gone.)

  The app writes two shop metafields at install (namespace let_agents): site_key, the store's public
  key, and api, the Let Agents API address. Without either nothing is printed, so a store that has not
  finished installing keeps its own search.

  The context mirrors what the WooCommerce plugin prints (plugins/woocommerce/src/Storefront/Search.php),
  mapped to Shopify: no Store API or nonce; prices, stock and the cart come from the storefront's own
  public endpoints under `root`. `page` names the product or article being read, so the drawer starts
  with it and counts its views and learning.
{% endcomment %}
{%- liquid
  assign site = shop.metafields.let_agents.site_key.value | strip
  assign api = shop.metafields.let_agents.api.value | strip
  assign api_last = api | slice: -1
  if api_last == '/'
    assign api = api | remove_last: '/'
  endif
  assign api_scheme = api | slice: 0, 8

  assign page_type = ''
  if template.name == 'product' and product
    assign page_type = 'product'
    assign page_id = product.id | append: ''
  elsif template.name == 'article' and article
    assign page_type = 'content'
    assign page_id = article.id | append: ''
  endif
-%}
{%- if site != blank and api != blank and api_scheme == 'https://' -%}
  <script>
    window.LetAgentsSearchContext = {
      "platform": "shopify",
      "site": {{ site | json }},
      "api": {{ api | json }},
      "locale": {{ request.locale.iso_code | slice: 0, 2 | json }},
      "root": {{ routes.root_url | json }},
      "searchUrl": {{ routes.search_url | json }},
      "cartUrl": {{ routes.cart_url | json }},
      "currency": {{ cart.currency.iso_code | default: shop.currency | json }},
      "shopCurrency": {{ shop.currency | json }},
      "moneyFormat": {{ shop.money_format | strip_html | json }},
      "loggedIn": {% if customer %}true{% else %}false{% endif %}
      {%- if page_type != '' -%},
      "page": { "type": {{ page_type | json }}, "id": {{ page_id | json }} }
      {%- endif %}
    };
  </script>
  <script src="{{ api | append: '/search/lets-search.js' | escape }}" defer></script>
{%- endif -%}

{%- comment -%} A guide Let Agents wrote carries its questions in let_agents.faq: search engines read them as FAQPage. {%- endcomment -%}
{%- if template.name == 'article' and article.metafields.let_agents.faq.value != blank -%}
  <script type="application/ld+json">
    {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
    {%- for item in article.metafields.let_agents.faq.value -%}
      {"@type": "Question", "name": {{ item.q | json }}, "acceptedAnswer": {"@type": "Answer", "text": {{ item.a | json }}}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
    ]}
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.app_embed.name",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:blocks.app_embed.settings.about.content"
    }
  ]
}
{% endschema %}
