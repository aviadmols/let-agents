{% comment %}
  The Let's search page component, where the merchant puts it: a block inside the product area of a
  product page, or in a blog post. It is the same widget the WooCommerce plugin prints
  (plugins/woocommerce/src/Storefront/Widget.php), told it runs on Shopify: prices and stock come
  from /products/{handle}.js and the cart is the store's own.

  Needs the two shop metafields the app writes at install (namespace let_agents: site_key, api);
  without them, or outside a product or a post, nothing is printed.
{% endcomment %}
{%- liquid
  assign site = shop.metafields.let_agents.site_key.value | strip
  assign api = shop.metafields.let_agents.api.value | strip
  assign api_last = api | slice: -1
  if api_last == '/'
    assign api = api | remove_last: '/'
  endif
  assign api_scheme = api | slice: 0, 8

  assign kind = blank
  if product
    assign kind = 'product'
    assign page_id = product.id
    assign page_url = product.url
  elsif article
    assign kind = 'content'
    assign page_id = article.id
    assign page_url = article.url
  endif
-%}
{%- if site != blank and api != blank and api_scheme == 'https://' and kind != blank -%}
  <div class="let-agents-widget-block" data-let-agents-widget {{ block.shopify_attributes }} style="margin: {{ block.settings.space }}px 0;">
    {%- if request.design_mode -%}
      <p class="let-agents-widget-block__note" style="margin:0;padding:10px 12px;border:1px dashed rgba(0,0,0,.25);border-radius:8px;font-size:13px;opacity:.75">
        {%- if request.locale.iso_code contains 'he' -%}כאן יוצג הרכיב של Let's search: שאלות, מוצרים דומים ומידע על {% if kind == 'product' %}המוצר{% else %}הפוסט{% endif %}. בעורך הוא מופיע רק כשיש לו תוכן לעמוד הזה.{%- else -%}The Let's search component shows here: questions, similar products and information about this {% if kind == 'product' %}product{% else %}post{% endif %}. In the editor it shows only when it has content for this page.{%- endif -%}
      </p>
      <style>[data-let-agents-widget] > .let-agents-widget-block__note:not(:only-child){display:none}</style>
    {%- endif -%}
  </div>
  <script>
    window.LetAgentsContext = {
      "platform": "shopify",
      "site": {{ site | json }},
      "api": {{ api | json }},
      "mode": "live",
      "page": { "type": {{ kind | json }}, "id": {{ page_id | append: '' | json }}, "url": {{ page_url | json }} },
      "locale": {{ request.locale.iso_code | slice: 0, 2 | json }},
      "root": {{ routes.root_url | json }},
      "cartUrl": {{ routes.cart_url | json }},
      "moneyFormat": {{ shop.money_format | strip_html | json }}
    };
  </script>
  <script src="{{ api | append: '/widget/let-agents.js' | escape }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.page_widget.name",
  "target": "section",
  "enabled_on": {
    "templates": ["product", "article"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:blocks.page_widget.settings.about.content"
    },
    {
      "type": "range",
      "id": "space",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "t:blocks.page_widget.settings.space.label",
      "default": 12
    }
  ]
}
{% endschema %}
