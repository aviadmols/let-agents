{
    "name": "Leads",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Runs",
        "Catalog",
        "Enrichment",
        "Assistant",
        "Shoppers",
        "Analytics",
        "Ai",
        "Admin",
        "Connections"
    ],
    "provider": "LeadsServiceProvider",
    "features": [
        {
            "name": "enabled",
            "default": false
        }
    ],
    "settings": [
        {
            "name": "steps_per_minute",
            "type": "int",
            "default": 30,
            "min": 5,
            "max": 300,
            "scope": "global",
            "unit": "requests"
        },
        {
            "name": "retention_days",
            "type": "int",
            "default": 365,
            "min": 30,
            "max": 3650,
            "scope": "shop",
            "unit": "days"
        },
        {
            "name": "writer_model",
            "type": "string",
            "default": "gpt-5.4-mini",
            "scope": "global"
        },
        {
            "name": "reviewer_model",
            "type": "string",
            "default": "gpt-5.4-nano",
            "scope": "global"
        },
        {
            "name": "reviewer_bar",
            "type": "int",
            "default": 70,
            "min": 40,
            "max": 95,
            "scope": "global",
            "unit": "points"
        },
        {
            "name": "model_tokens",
            "type": "int",
            "default": 700,
            "min": 200,
            "max": 3000,
            "scope": "global",
            "unit": "tokens"
        },
        {
            "name": "pages_written_per_night",
            "type": "int",
            "default": 20,
            "min": 0,
            "max": 500,
            "scope": "shop",
            "unit": "pages"
        },
        {
            "name": "writer_provider",
            "type": "enum",
            "options": [
                "openai",
                "anthropic",
                "gemini"
            ],
            "default": "openai",
            "scope": "global"
        },
        {
            "name": "writer_input_usd_per_million",
            "type": "float",
            "default": 1.0,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "writer_output_usd_per_million",
            "type": "float",
            "default": 8.0,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "reviewer_provider",
            "type": "enum",
            "options": [
                "openai",
                "anthropic",
                "gemini"
            ],
            "default": "openai",
            "scope": "global"
        },
        {
            "name": "reviewer_input_usd_per_million",
            "type": "float",
            "default": 0.3,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "reviewer_output_usd_per_million",
            "type": "float",
            "default": 2.5,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        }
    ],
    "agents": [
        {
            "name": "writer",
            "action": "write_ctas",
            "when": "01:20",
            "features": [
                "enabled"
            ],
            "roles": [
                {
                    "role": "writer",
                    "provider": "writer_provider",
                    "model": "writer_model",
                    "prices": [
                        "writer_input_usd_per_million",
                        "writer_output_usd_per_million"
                    ],
                    "prompts": [
                        "write_cta"
                    ]
                },
                {
                    "role": "checker",
                    "provider": "reviewer_provider",
                    "model": "reviewer_model",
                    "prices": [
                        "reviewer_input_usd_per_million",
                        "reviewer_output_usd_per_million"
                    ],
                    "prompts": [
                        "review_cta"
                    ]
                }
            ],
            "run": {
                "command": "leads",
                "step": "write",
                "shop_argument": "target"
            }
        }
    ]
}
