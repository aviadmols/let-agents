{
    "name": "Catalog",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Runs",
        "Connections",
        "Admin"
    ],
    "provider": "CatalogServiceProvider",
    "features": [
        { "name": "daily_sync", "default": true },
        { "name": "live_sync", "default": true }
    ],
    "settings": [
        { "name": "max_products", "type": "int", "default": 10000, "min": 100, "max": 200000, "scope": "shop", "unit": "products" },
        { "name": "max_content_items", "type": "int", "default": 2000, "min": 0, "max": 50000, "scope": "shop", "unit": "items" }
    ]
}
