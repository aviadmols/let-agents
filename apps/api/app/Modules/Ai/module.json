{
    "name": "Ai",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Runs",
        "Admin"
    ],
    "provider": "AiServiceProvider",
    "features": [
        {
            "name": "credit_purchase",
            "default": false
        }
    ],
    "settings": [
        { "name": "monthly_spend_cap_usd", "type": "float", "default": 50, "min": 0, "max": 10000, "scope": "global", "unit": "usd" },
        { "name": "shop_monthly_cap_usd", "type": "float", "default": 30, "min": 0, "max": 10000, "scope": "shop", "unit": "usd" },
        { "name": "shop_cap_stops_shoppers", "type": "bool", "default": false, "scope": "shop" },
        { "name": "shop_cap_warn_percent", "type": "int", "default": 80, "min": 50, "max": 99, "scope": "global", "unit": "percent" },
        { "name": "credit_pack_small_usd", "type": "float", "default": 10, "min": 1, "max": 1000, "scope": "global", "unit": "usd" },
        { "name": "credit_pack_medium_usd", "type": "float", "default": 25, "min": 1, "max": 1000, "scope": "global", "unit": "usd" },
        { "name": "credit_pack_large_usd", "type": "float", "default": 50, "min": 1, "max": 1000, "scope": "global", "unit": "usd" },
        { "name": "credit_markup", "type": "int", "default": 10, "min": 1, "max": 50, "scope": "global" },
        { "name": "credit_requests_to", "type": "string", "default": "support@lets.co.il", "min": 3, "max": 120, "scope": "global" }
    ]
}
