{
    "name": "Retrieval",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Runs",
        "Catalog",
        "Analytics",
        "Ai",
        "Admin"
    ],
    "provider": "RetrievalServiceProvider",
    "features": [
        {
            "name": "index",
            "default": true
        },
        {
            "name": "ai_matching",
            "default": true
        }
    ],
    "settings": [
        {
            "name": "embedding_provider",
            "type": "string",
            "default": "openai",
            "min": 1,
            "max": 40,
            "scope": "global"
        },
        {
            "name": "embedding_model",
            "type": "string",
            "default": "text-embedding-3-small",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "embedding_dimensions",
            "type": "int",
            "default": 0,
            "min": 0,
            "max": 4096,
            "scope": "global"
        },
        {
            "name": "embedding_usd_per_million",
            "type": "float",
            "default": 0.02,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "chunk_chars",
            "type": "int",
            "default": 1200,
            "min": 300,
            "max": 6000,
            "scope": "global",
            "unit": "characters"
        },
        {
            "name": "max_chunks_per_run",
            "type": "int",
            "default": 5000,
            "min": 100,
            "max": 200000,
            "scope": "shop",
            "unit": "chunks"
        },
        {
            "name": "purchase_window_days",
            "type": "int",
            "default": 730,
            "min": 30,
            "max": 1095,
            "scope": "shop",
            "unit": "days"
        },
        {
            "name": "match_provider",
            "type": "string",
            "default": "openai",
            "min": 1,
            "max": 40,
            "scope": "global"
        },
        {
            "name": "match_model",
            "type": "string",
            "default": "gpt-5.4-mini",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "match_reasoning_effort",
            "type": "enum",
            "options": [
                "model_default",
                "minimal",
                "low",
                "medium"
            ],
            "default": "low",
            "scope": "global"
        },
        {
            "name": "match_input_usd_per_million",
            "type": "float",
            "default": 1,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "match_output_usd_per_million",
            "type": "float",
            "default": 8,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "match_max_output_tokens",
            "type": "int",
            "default": 2000,
            "min": 300,
            "max": 16000,
            "scope": "global",
            "unit": "tokens"
        },
        {
            "name": "match_products_per_run",
            "type": "int",
            "default": 150,
            "min": 0,
            "max": 5000,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "match_candidates",
            "type": "int",
            "default": 24,
            "min": 4,
            "max": 60,
            "scope": "global",
            "unit": "products"
        },
        {
            "name": "match_max_share_of_cap",
            "type": "float",
            "default": 0.5,
            "min": 0.05,
            "max": 1,
            "scope": "global"
        },
        {
            "name": "complements_per_product",
            "type": "int",
            "default": 4,
            "min": 1,
            "max": 12,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "alternatives_per_product",
            "type": "int",
            "default": 4,
            "min": 0,
            "max": 12,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "min_alternative_similarity",
            "type": "float",
            "default": 0.5,
            "min": 0,
            "max": 1,
            "scope": "global"
        }
    ]
}
