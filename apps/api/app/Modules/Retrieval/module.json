{
    "name": "Retrieval",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Runs",
        "Catalog",
        "Analytics",
        "Ai",
        "Admin"
    ],
    "provider": "RetrievalServiceProvider",
    "features": [
        {
            "name": "index",
            "default": true
        },
        {
            "name": "ai_matching",
            "default": true
        },
        {
            "name": "image_index",
            "default": false
        }
    ],
    "settings": [
        {
            "name": "embedding_provider",
            "type": "string",
            "default": "openai",
            "min": 1,
            "max": 40,
            "scope": "global"
        },
        {
            "name": "embedding_model",
            "type": "string",
            "default": "text-embedding-3-small",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "embedding_dimensions",
            "type": "int",
            "default": 0,
            "min": 0,
            "max": 4096,
            "scope": "global"
        },
        {
            "name": "embedding_usd_per_million",
            "type": "float",
            "default": 0.02,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "chunk_chars",
            "type": "int",
            "default": 1200,
            "min": 300,
            "max": 6000,
            "scope": "global",
            "unit": "characters"
        },
        {
            "name": "max_chunks_per_run",
            "type": "int",
            "default": 5000,
            "min": 100,
            "max": 200000,
            "scope": "shop",
            "unit": "chunks"
        },
        {
            "name": "purchase_window_days",
            "type": "int",
            "default": 730,
            "min": 30,
            "max": 1095,
            "scope": "shop",
            "unit": "days"
        },
        {
            "name": "match_provider",
            "type": "string",
            "default": "openai",
            "min": 1,
            "max": 40,
            "scope": "global"
        },
        {
            "name": "match_model",
            "type": "string",
            "default": "gpt-5.4-mini",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "match_reasoning_effort",
            "type": "enum",
            "options": [
                "model_default",
                "minimal",
                "low",
                "medium"
            ],
            "default": "low",
            "scope": "global"
        },
        {
            "name": "match_input_usd_per_million",
            "type": "float",
            "default": 1,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "match_output_usd_per_million",
            "type": "float",
            "default": 8,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "match_max_output_tokens",
            "type": "int",
            "default": 2000,
            "min": 300,
            "max": 16000,
            "scope": "global",
            "unit": "tokens"
        },
        {
            "name": "match_products_per_run",
            "type": "int",
            "default": 150,
            "min": 0,
            "max": 5000,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "match_candidates",
            "type": "int",
            "default": 24,
            "min": 4,
            "max": 60,
            "scope": "global",
            "unit": "products"
        },
        {
            "name": "match_max_share_of_cap",
            "type": "float",
            "default": 0.5,
            "min": 0.05,
            "max": 1,
            "scope": "global"
        },
        {
            "name": "complements_per_product",
            "type": "int",
            "default": 4,
            "min": 1,
            "max": 12,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "alternatives_per_product",
            "type": "int",
            "default": 4,
            "min": 0,
            "max": 12,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "min_alternative_similarity",
            "type": "float",
            "default": 0.5,
            "min": 0,
            "max": 1,
            "scope": "global"
        },
        {
            "name": "image_provider",
            "type": "string",
            "default": "gemini",
            "min": 1,
            "max": 40,
            "scope": "global"
        },
        {
            "name": "image_model",
            "type": "string",
            "default": "gemini-embedding-2",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "image_dimensions",
            "type": "int",
            "default": 768,
            "min": 0,
            "max": 4096,
            "scope": "global"
        },
        {
            "name": "image_usd_per_image",
            "type": "float",
            "default": 0.00012,
            "min": 0,
            "max": 1,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "image_text_usd_per_million",
            "type": "float",
            "default": 0.2,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "max_images_per_run",
            "type": "int",
            "default": 2000,
            "min": 0,
            "max": 100000,
            "scope": "shop",
            "unit": "images"
        },
        {
            "name": "image_max_kb",
            "type": "int",
            "default": 4096,
            "min": 100,
            "max": 20000,
            "scope": "global",
            "unit": "kilobytes"
        },
        {
            "name": "min_look_alike",
            "type": "float",
            "default": 0.75,
            "min": 0,
            "max": 1,
            "scope": "global"
        }
    ],
    "agents": [
        {
            "name": "indexer",
            "action": "build_index",
            "when": "02:45",
            "features": [
                "index"
            ],
            "roles": [
                {
                    "role": "embedder",
                    "provider": "embedding_provider",
                    "model": "embedding_model",
                    "prices": [
                        "embedding_usd_per_million"
                    ]
                }
            ],
            "run": {
                "command": "retrieval",
                "step": "index",
                "shop_argument": "target"
            }
        },
        {
            "name": "image_indexer",
            "action": "build_image_index",
            "when": "02:45",
            "features": [
                "image_index"
            ],
            "roles": [
                {
                    "role": "embedder",
                    "provider": "image_provider",
                    "model": "image_model",
                    "prices": [
                        "image_usd_per_image",
                        "image_text_usd_per_million"
                    ]
                }
            ],
            "run": {
                "command": "retrieval",
                "step": "images",
                "shop_argument": "target"
            }
        },
        {
            "name": "query_embedder",
            "action": "embed_queries",
            "when": "live",
            "features": [],
            "roles": [
                {
                    "role": "embedder",
                    "provider": "embedding_provider",
                    "model": "embedding_model",
                    "prices": [
                        "embedding_usd_per_million"
                    ]
                }
            ]
        },
        {
            "name": "matcher",
            "action": "match_products",
            "when": "02:45",
            "features": [
                "ai_matching"
            ],
            "roles": [
                {
                    "role": "writer",
                    "provider": "match_provider",
                    "model": "match_model",
                    "prices": [
                        "match_input_usd_per_million",
                        "match_output_usd_per_million"
                    ],
                    "prompts": [
                        "match"
                    ]
                }
            ],
            "run": {
                "command": "retrieval",
                "step": "match",
                "shop_argument": "target"
            }
        }
    ]
}
