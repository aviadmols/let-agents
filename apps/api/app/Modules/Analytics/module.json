{
    "name": "Analytics",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Runs",
        "Connections",
        "Catalog",
        "Admin"
    ],
    "provider": "AnalyticsServiceProvider",
    "features": [
        {
            "name": "collect",
            "default": true
        },
        {
            "name": "sessions",
            "default": true
        }
    ],
    "settings": [
        {
            "name": "attribution_days",
            "type": "int",
            "default": 7,
            "min": 1,
            "max": 30,
            "scope": "shop",
            "unit": "days"
        },
        {
            "name": "beacons_per_minute",
            "type": "int",
            "default": 120,
            "min": 10,
            "max": 2000,
            "scope": "global",
            "unit": "requests"
        },
        {
            "name": "retention_days",
            "type": "int",
            "default": 3650,
            "min": 30,
            "max": 3650,
            "scope": "global",
            "unit": "days"
        },
        {
            "name": "score_window_days",
            "type": "int",
            "default": 30,
            "min": 7,
            "max": 180,
            "scope": "shop",
            "unit": "days"
        },
        {
            "name": "score_prior_exposures",
            "type": "int",
            "default": 20,
            "min": 1,
            "max": 500,
            "scope": "shop",
            "unit": "exposures"
        },
        {
            "name": "drop_related_after_opens",
            "type": "int",
            "default": 40,
            "min": 10,
            "max": 5000,
            "scope": "shop",
            "unit": "opens"
        },
        {
            "name": "popularity_window_days",
            "type": "int",
            "default": 30,
            "min": 7,
            "max": 180,
            "scope": "shop",
            "unit": "days"
        },
        {
            "name": "popular_min_score",
            "type": "int",
            "default": 5,
            "min": 1,
            "max": 100000,
            "scope": "shop",
            "unit": "points"
        },
        {
            "name": "popular_top_percent",
            "type": "int",
            "default": 10,
            "min": 1,
            "max": 50,
            "scope": "shop",
            "unit": "percent"
        },
        {
            "name": "holdout_percent",
            "type": "int",
            "default": 10,
            "min": 0,
            "max": 50,
            "scope": "shop",
            "unit": "percent"
        },
        {
            "name": "measure_min_exposures",
            "type": "int",
            "default": 200,
            "min": 20,
            "max": 100000,
            "scope": "shop",
            "unit": "exposures"
        },
        {
            "name": "prior_min_shops",
            "type": "int",
            "default": 2,
            "min": 2,
            "max": 50,
            "scope": "global",
            "unit": "shops"
        },
        {
            "name": "sessions_keep_days",
            "type": "int",
            "default": 90,
            "min": 7,
            "max": 400,
            "scope": "global",
            "unit": "days"
        },
        {
            "name": "visits_per_minute",
            "type": "int",
            "default": 120,
            "min": 10,
            "max": 2000,
            "scope": "global",
            "unit": "requests"
        },
        {
            "name": "ip_alert_per_day",
            "type": "int",
            "default": 200,
            "min": 20,
            "max": 100000,
            "scope": "shop",
            "unit": "requests"
        }
    ]
}
