{
    "name": "Alerts",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Runs",
        "Ai",
        "Admin"
    ],
    "provider": "AlertsServiceProvider",
    "features": [
        { "name": "email", "default": true }
    ],
    "settings": [
        { "name": "budget_warn_percent", "type": "int", "default": 80, "min": 50, "max": 99, "scope": "global", "unit": "percent" },
        { "name": "failed_runs", "type": "int", "default": 3, "min": 1, "max": 50, "scope": "global", "unit": "times" },
        { "name": "stuck_hours", "type": "int", "default": 6, "min": 1, "max": 24, "scope": "global", "unit": "hours" },
        { "name": "queue_minutes", "type": "int", "default": 20, "min": 5, "max": 240, "scope": "global", "unit": "minutes" },
        { "name": "sync_hours", "type": "int", "default": 30, "min": 12, "max": 168, "scope": "global", "unit": "hours" },
        { "name": "repeat_hours", "type": "int", "default": 24, "min": 1, "max": 168, "scope": "global", "unit": "hours" }
    ]
}
