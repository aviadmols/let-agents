{
    "name": "Runs",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Admin"
    ],
    "provider": "RunsServiceProvider",
    "features": [],
    "settings": [
        {
            "name": "retention_days",
            "type": "int",
            "default": 365,
            "min": 7,
            "max": 3650,
            "scope": "global",
            "unit": "days"
        },
        {
            "name": "call_log_days",
            "type": "int",
            "default": 30,
            "min": 1,
            "max": 90,
            "scope": "global",
            "unit": "days"
        }
    ]
}
