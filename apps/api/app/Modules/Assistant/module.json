            "unit": "usd"
        },
        {
            "name": "post_reader_max_output_tokens",
            "type": "int",
            "default": 800,
            "min": 100,
            "max": 4000,
            "scope": "global",
            "unit": "tokens"
        },
        {
            "name": "post_check_provider",
            "type": "enum",
            "options": [
                "openai",
                "anthropic",
                "gemini"
            ],
            "default": "anthropic",
            "scope": "global"
        },
        {
            "name": "post_check_model",
            "type": "string",
            "default": "claude-haiku-4-5",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "post_check_input_usd_per_million",
            "type": "float",
            "default": 1,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "post_check_output_usd_per_million",
            "type": "float",
            "default": 5,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "post_check_max_output_tokens",
            "type": "int",
            "default": 800,
            "min": 100,
            "max": 4000,
            "scope": "global",
            "unit": "tokens"
        },
        {
            "name": "post_knowledge_pages",
            "type": "int",
            "default": 30,
            "min": 0,
            "max": 200,
            "scope": "shop",
            "unit": "items"
        },
        {
            "name": "post_knowledge_posts",
            "type": "int",
            "default": 40,
            "min": 0,
            "max": 300,
            "scope": "shop",
            "unit": "posts"
        },
        {
            "name": "post_knowledge_per_run",
            "type": "int",
            "default": 15,
            "min": 0,
            "max": 100,
            "scope": "shop",
            "unit": "posts"
        },
        {
            "name": "team_drafts_per_day",
            "type": "int",
            "default": 40,
            "min": 0,
            "max": 500,
            "scope": "shop",
            "unit": "requests"
        }
    ],
    "agents": [
        {
            "name": "answerer",
            "action": "answer",
            "when": "live",
            "features": [
                "on_products",
                "on_content"
            ],
            "roles": [
                {
                    "role": "writer",
                    "provider": "answer_provider",
                    "model": "answer_model",
                    "prices": [
                        "answer_input_usd_per_million",
                        "answer_output_usd_per_million"
                    ],
                    "prompts": [
                        "answer",
                        "answer_article"
                    ]
                },
                {
                    "role": "checker",
                    "provider": "scope_provider",
                    "model": "scope_model",
                    "prices": [
                        "scope_input_usd_per_million",
                        "scope_output_usd_per_million"
                    ],
                    "prompts": [
                        "scope",
                        "scope_article",
                        "verify",
                        "verify_article"
                    ]
                }
            ]
        },
        {
            "name": "site_answerer",
            "action": "answer_site",
            "when": "live",
            "features": [
                "on_search"
            ],
            "roles": [
                {
                    "role": "writer",
                    "provider": "answer_provider",
                    "model": "answer_model",
                    "prices": [
                        "answer_input_usd_per_million",
                        "answer_output_usd_per_million"
                    ],
                    "prompts": [
                        "answer_site"
                    ]
                },
                {
                    "role": "checker",
                    "provider": "site_check_provider",
                    "model": "site_check_model",
                    "prices": [
                        "site_check_input_usd_per_million",
                        "site_check_output_usd_per_million"
                    ],
                    "prompts": [
                        "verify_site"
                    ]
                }
            ]
        },
        {
            "name": "ask_reviewer",
            "action": "review_asks",
            "when": "05:15",
            "features": [
                "ask_review"
            ],
            "roles": [
                {
                    "role": "checker",
                    "provider": "review_provider",
                    "model": "review_model",
                    "prices": [
                        "review_input_usd_per_million",
                        "review_output_usd_per_million"
                    ],
                    "prompts": [
                        "review_asks"
                    ]
                }
            ],
            "run": {
                "command": "assistant:review-asks",
                "shop_argument": "shop"
            }
        },
        {
            "name": "post_reader",
            "action": "read_posts",
            "when": "03:40",
            "features": [
                "knowledge"
            ],
            "roles": [
                {
                    "role": "writer",
                    "provider": "post_reader_provider",
                    "model": "post_reader_model",
                    "prices": [
                        "post_reader_input_usd_per_million",
                        "post_reader_output_usd_per_million"
                    ],
                    "prompts": [
                        "post_facts"
                    ]
                },
                {
                    "role": "checker",
                    "provider": "post_check_provider",
                    "model": "post_check_model",
                    "prices": [
                        "post_check_input_usd_per_million",
                        "post_check_output_usd_per_million"
                    ],
                    "prompts": [
                        "post_facts_check"
                    ]
                }
            ],
            "run": {
                "command": "assistant:read-posts",
                "shop_argument": "shop"
            }
        },
        {
            "name": "team_helper",
            "action": "draft_team_answer",
            "when": "on_request",
            "features": [
                "team_drafts"
            ],
            "roles": [
                {
                    "role": "writer",
                    "provider": "answer_provider",
                    "model": "answer_model",
                    "prices": [
                        "answer_input_usd_per_million",
                        "answer_output_usd_per_million"
                    ],
                    "prompts": [
                        "team_answer"
                    ]
                },
                {
                    "role": "checker",
                    "provider": "post_check_provider",
                    "model": "post_check_model",
                    "prices": [
                        "post_check_input_usd_per_million",
                        "post_check_output_usd_per_million"
                    ],
                    "prompts": [
                        "team_answer_check"
                    ]
                }
            ]
        },
        {
            "name": "knowledge_checker",
            "action": "check_own_knowledge",
            "when": "on_request",
            "features": [
                "knowledge"
            ],
            "roles": [
                {
                    "role": "checker",
                    "provider": "post_check_provider",
                    "model": "post_check_model",
                    "prices": [
                        "post_check_input_usd_per_million",
                        "post_check_output_usd_per_million"
                    ],
                    "prompts": [
                        "own_fact_check"
                    ]
                }
            ]
        }
    ]
}
