            "default": "full",
            "scope": "shop"
        },
        {
            "name": "context_min_products",
            "type": "int",
            "default": 3,
            "min": 0,
            "max": 12,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "context_keep_ratio",
            "type": "float",
            "default": 0.5,
            "min": 0,
            "max": 1,
            "scope": "shop"
        },
        {
            "name": "context_open_keep_ratio",
            "type": "float",
            "default": 0.3,
            "min": 0,
            "max": 1,
            "scope": "shop"
        },
        {
            "name": "answer_input_usd_per_million",
            "type": "float",
            "default": 1,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "answer_output_usd_per_million",
            "type": "float",
            "default": 8,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "scope_input_usd_per_million",
