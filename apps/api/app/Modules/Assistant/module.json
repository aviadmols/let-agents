            "max": 20000,
            "scope": "shop",
            "unit": "questions"
        },
        {
            "name": "asks_per_minute",
            "type": "int",
            "default": 20,
            "min": 1,
            "max": 600,
            "scope": "global",
            "unit": "requests"
        },
        {
            "name": "suggested_questions",
            "type": "int",
            "default": 4,
            "min": 0,
            "max": 8,
            "scope": "shop",
            "unit": "questions"
        },
        {
            "name": "site_check_provider",
            "type": "string",
            "default": "anthropic",
            "min": 1,
            "max": 40,
            "scope": "global"
        },
        {
            "name": "site_check_model",
            "type": "string",
            "default": "claude-haiku-5-5",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "site_check_input_usd_per_million",
            "type": "float",
            "default": 0.1,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "site_check_max_output_tokens",
            "type": "int",
            "default": 3000,
            "min": 100,
            "max": 4000,
            "scope": "global",
            "unit": "tokens"
        },
        {
            "name": "site_check_output_usd_per_million",
            "type": "float",
            "default": 0.5,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "site_passages",
            "type": "int",
            "default": 6,
            "min": 2,
            "max": 20,
            "scope": "shop",
            "unit": "passages"
        },
        {
            "name": "site_min_similarity",
            "type": "float",
            "default": 0.35,
            "min": 0,
            "max": 1,
            "scope": "shop"
        },
        {
            "name": "site_retry_days",
            "type": "int",
            "default": 7,
            "min": 1,
            "max": 90,
            "scope": "shop",
            "unit": "days"
        },
        {
            "name": "answer_provider",
            "type": "enum",
            "options": [
                "openai",
                "anthropic",
                "gemini"
            ],
            "default": "openai",
            "scope": "global"
        },
        {
            "name": "scope_provider",
            "type": "enum",
            "options": [
                "openai",
                "anthropic",
                "gemini"
            ],
            "default": "openai",
            "scope": "global"
        },
        {
            "name": "no_answer",
            "type": "enum",
            "options": [
