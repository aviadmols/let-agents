{
    "name": "Assistant",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Runs",
        "Ai",
        "Connections",
        "Catalog",
        "Enrichment",
        "Admin",
        "Retrieval"
    ],
    "provider": "AssistantServiceProvider",
    "features": [
        {
            "name": "on_products",
            "default": true
        },
        {
            "name": "on_content",
            "default": true
        },
        {
            "name": "on_search",
            "default": true
        }
    ],
    "settings": [
        {
            "name": "answer_model",
            "type": "string",
            "default": "gpt-5.4-mini",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "scope_model",
            "type": "string",
            "default": "gpt-5.4-nano",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "reasoning_effort",
            "type": "enum",
            "options": [
                "model_default",
                "minimal",
                "low",
                "medium"
            ],
            "default": "low",
            "scope": "global"
        },
        {
            "name": "answer_input_usd_per_million",
            "type": "float",
            "default": 1,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "answer_output_usd_per_million",
            "type": "float",
            "default": 8,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "scope_input_usd_per_million",
            "type": "float",
            "default": 0.3,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "scope_output_usd_per_million",
            "type": "float",
            "default": 2.5,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "answer_max_output_tokens",
            "type": "int",
            "default": 1500,
            "min": 200,
            "max": 8000,
            "scope": "global",
            "unit": "tokens"
        },
        {
            "name": "max_question_chars",
            "type": "int",
            "default": 200,
            "min": 20,
            "max": 500,
            "scope": "shop",
            "unit": "characters"
        },
        {
            "name": "max_text_chars",
            "type": "int",
            "default": 4000,
            "min": 500,
            "max": 12000,
            "scope": "shop",
            "unit": "characters"
        },
        {
            "name": "questions_per_visitor_per_day",
            "type": "int",
            "default": 10,
            "min": 1,
            "max": 200,
            "scope": "shop",
            "unit": "questions"
        },
        {
            "name": "questions_per_shop_per_day",
            "type": "int",
            "default": 300,
            "min": 10,
            "max": 20000,
            "scope": "shop",
            "unit": "questions"
        },
        {
            "name": "asks_per_minute",
            "type": "int",
            "default": 20,
            "min": 1,
            "max": 600,
            "scope": "global",
            "unit": "requests"
        },
        {
            "name": "suggested_questions",
            "type": "int",
            "default": 4,
            "min": 0,
            "max": 8,
            "scope": "shop",
            "unit": "questions"
        },
        {
            "name": "site_check_provider",
            "type": "string",
            "default": "anthropic",
            "min": 1,
            "max": 40,
            "scope": "global"
        },
        {
            "name": "site_check_model",
            "type": "string",
            "default": "claude-haiku-4-5",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "site_check_input_usd_per_million",
            "type": "float",
            "default": 1,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "site_check_output_usd_per_million",
            "type": "float",
            "default": 5,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "site_passages",
            "type": "int",
            "default": 6,
            "min": 2,
            "max": 20,
            "scope": "shop",
            "unit": "passages"
        },
        {
            "name": "site_min_similarity",
            "type": "float",
            "default": 0.35,
            "min": 0,
            "max": 1,
            "scope": "shop"
        },
        {
            "name": "site_retry_days",
            "type": "int",
            "default": 7,
            "min": 1,
            "max": 90,
            "scope": "shop",
            "unit": "days"
        }
    ]
}
