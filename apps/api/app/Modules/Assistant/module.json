                "details",
                "none"
            ],
            "default": "team",
            "scope": "shop"
        },
        {
            "name": "search_whatsapp_message",
            "type": "string",
            "default": "",
            "max": 300,
            "scope": "shop"
        },
        {
            "name": "review_provider",
            "type": "enum",
            "options": [
                "openai",
                "anthropic",
                "gemini"
            ],
            "default": "anthropic",
