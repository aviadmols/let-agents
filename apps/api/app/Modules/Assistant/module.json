            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "post_reader_provider",
            "type": "enum",
            "options": [
                "openai",
                "anthropic",
                "gemini"
            ],
            "default": "openai",
            "scope": "global"
        },
        {
            "name": "post_reader_model",
            "type": "string",
            "default": "gpt-5.4-mini",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "post_reader_input_usd_per_million",
            "type": "float",
            "default": 1,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "post_reader_output_usd_per_million",
            "type": "float",
            "default": 8,
