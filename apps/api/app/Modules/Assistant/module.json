            "default": 3,
            "min": 1,
            "max": 5,
            "scope": "shop",
            "unit": "points"
        },
        {
            "name": "review_max_output_tokens",
            "type": "int",
            "default": 4000,
            "min": 500,
            "max": 16000,
            "scope": "global",
            "unit": "tokens"
        },
        {
            "name": "weak_answer_max_score",
            "type": "int",
            "default": 2,
            "min": 1,
            "max": 4,
            "scope": "global",
