            "default": 3,
            "min": 1,
            "max": 50,
            "scope": "shop",
            "unit": "questions"
        },
        {
            "name": "block_network_after_violations",
            "type": "int",
            "default": 30,
            "min": 5,
            "max": 1000,
            "scope": "shop",
            "unit": "questions"
        },
        {
            "name": "block_hours",
            "type": "int",
            "default": 24,
