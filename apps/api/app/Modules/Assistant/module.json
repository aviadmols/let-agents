{
    "name": "Assistant",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Runs",
        "Ai",
        "Connections",
        "Catalog",
        "Enrichment",
        "Admin",
        "Retrieval"
    ],
    "provider": "AssistantServiceProvider",
    "features": [
        {
            "name": "prepare_answers",
            "default": true
        },
        {
            "name": "on_products",
            "default": true
        },
        {
            "name": "on_content",
            "default": true
        },
        {
            "name": "on_search",
            "default": true
        },
        {
            "name": "search_whatsapp",
            "default": true
        },
        {
            "name": "ask_review",
            "default": true
        },
        {
            "name": "knowledge",
            "default": true
        },
        {
            "name": "site_scope",
            "default": true
        },
        {
            "name": "second_look",
            "default": true
        },
        {
            "name": "team_drafts",
            "default": true
        }
    ],
    "settings": [
        {
            "name": "prepared_per_sync",
            "type": "int",
            "default": 12,
            "min": 1,
            "max": 50,
            "scope": "shop",
            "unit": "questions"
        },
        {
            "name": "answer_model",
            "type": "string",
            "default": "gpt-5.4-mini",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "scope_model",
            "type": "string",
            "default": "gpt-5.4-nano",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "reasoning_effort",
            "type": "enum",
            "options": [
                "model_default",
                "minimal",
                "low",
                "medium"
            ],
            "default": "low",
            "scope": "global"
        },
        {
            "name": "context_mode",
            "type": "enum",
            "options": [
                "full",
                "dynamic"
