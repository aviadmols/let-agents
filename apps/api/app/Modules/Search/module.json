    "agents": [
        {
            "name": "tagger",
            "action": "write_tags",
            "when": "03:30",
            "features": [
                "page_tags"
            ],
            "roles": [
                {
                    "role": "writer",
                    "provider": "tags_provider",
                    "model": "tags_model",
                    "prices": [
                        "tags_input_usd_per_million",
                        "tags_output_usd_per_million"
                    ],
                    "prompts": [
                        "tags"
                    ]
                },
                {
                    "role": "checker",
                    "provider": "check_provider",
                    "model": "check_model",
                    "prices": [
                        "check_input_usd_per_million",
                        "check_output_usd_per_million"
                    ],
                    "prompts": [
                        "tags_check"
                    ]
                }
            ],
            "run": {
                "command": "search",
                "step": "tags",
                "shop_argument": "target"
            }
        },
        {
            "name": "resolver",
            "action": "resolve",
            "when": "04:00",
            "features": [
                "resolve_empty"
            ],
            "roles": [
                {
                    "role": "writer",
                    "provider": "resolve_provider",
                    "model": "resolve_model",
                    "prices": [
                        "resolve_input_usd_per_million",
                        "resolve_output_usd_per_million"
                    ],
                    "prompts": [
                        "resolve"
                    ]
                },
                {
                    "role": "checker",
                    "provider": "check_provider",
                    "model": "check_model",
                    "prices": [
                        "check_input_usd_per_million",
                        "check_output_usd_per_million"
                    ],
                    "prompts": [
                        "resolve_check"
                    ]
                }
            ],
            "run": {
                "command": "search",
                "step": "resolve",
                "shop_argument": "target"
            }
        },
        {
            "name": "photo_reader",
            "action": "read_photo",
            "when": "live",
            "features": [
                "photos",
                "photo_tags"
            ],
            "roles": [
                {
                    "role": "reader",
                    "provider": "photo_tags_provider",
                    "model": "photo_tags_model",
                    "prices": [
                        "photo_tags_input_usd_per_million",
                        "photo_tags_output_usd_per_million"
                    ],
                    "prompts": [
                        "photo_tags"
                    ]
                },
                {
                    "role": "second",
                    "provider": "photo_second_provider",
                    "model": "photo_second_model",
                    "prices": [
                        "photo_second_input_usd_per_million",
                        "photo_second_output_usd_per_million"
                    ],
                    "prompts": [
                        "photo_second_look"
                    ]
                },
                {
                    "role": "ranker",
                    "provider": "photo_rank_provider",
                    "model": "photo_rank_model",
                    "prices": [
                        "photo_rank_input_usd_per_million",
                        "photo_rank_output_usd_per_million"
                    ],
                    "prompts": [
                        "photo_rank"
                    ]
                }
            ]
        }
    ]
}
