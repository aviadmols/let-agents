{
    "name": "Search",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Runs",
        "Ai",
        "Connections",
        "Catalog",
        "Retrieval",
        "Admin",
        "Assistant"
    ],
    "provider": "SearchServiceProvider",
    "features": [
        {
            "name": "storefront",
            "default": true
        },
        {
            "name": "semantic",
            "default": true
        },
        {
            "name": "pictures",
            "default": true
        },
        {
            "name": "photos",
            "default": false
        },
        {
            "name": "resolve_empty",
            "default": true
        },
        {
            "name": "page_tags",
            "default": false
        }
    ],
    "settings": [
        {
            "name": "input_selector",
            "type": "string",
            "default": "input[name=\"s\"], input[type=\"search\"]",
            "min": 1,
            "max": 300,
            "scope": "shop"
        },
        {
            "name": "results",
            "type": "enum",
            "options": [
                "panel",
                "page"
            ],
            "default": "panel",
            "scope": "shop"
        },
        {
            "name": "suggestions",
            "type": "int",
            "default": 6,
            "min": 1,
            "max": 12,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "results_per_group",
            "type": "int",
            "default": 12,
            "min": 1,
            "max": 48,
            "scope": "shop",
            "unit": "results"
        },
        {
            "name": "semantic_results",
            "type": "int",
            "default": 24,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "results"
        },
        {
            "name": "semantic_min_similarity",
            "type": "float",
            "default": 0.3,
            "min": 0,
            "max": 1,
            "scope": "global"
        },
        {
            "name": "picture_min_similarity",
            "type": "float",
            "default": 0.35,
            "min": 0,
            "max": 1,
            "scope": "global"
        },
        {
            "name": "semantic_min_chars",
            "type": "int",
            "default": 3,
            "min": 1,
            "max": 50,
            "scope": "global",
            "unit": "characters"
        },
        {
            "name": "requests_per_minute",
            "type": "int",
            "default": 120,
            "min": 10,
            "max": 5000,
            "scope": "global",
            "unit": "requests"
        },
        {
            "name": "keep_days",
            "type": "int",
            "default": 365,
            "min": 30,
            "max": 1095,
            "scope": "global",
            "unit": "days"
        },
        {
            "name": "photo_max_kb",
            "type": "int",
            "default": 5120,
            "min": 100,
            "max": 20000,
            "scope": "global",
            "unit": "kilobytes"
        },
        {
            "name": "photos_per_day",
            "type": "int",
            "default": 500,
            "min": 0,
            "max": 100000,
            "scope": "shop",
            "unit": "searches"
        },
        {
            "name": "photo_requests_per_minute",
            "type": "int",
            "default": 10,
            "min": 1,
            "max": 600,
            "scope": "global",
            "unit": "requests"
        },
        {
            "name": "photo_min_similarity",
            "type": "float",
            "default": 0.5,
            "min": 0,
            "max": 1,
            "scope": "global"
        },
        {
            "name": "resolve_provider",
            "type": "string",
            "default": "openai",
            "min": 1,
            "max": 40,
            "scope": "global"
        },
        {
            "name": "resolve_model",
            "type": "string",
            "default": "gpt-5.4-mini",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "resolve_input_usd_per_million",
            "type": "float",
            "default": 1,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "resolve_output_usd_per_million",
            "type": "float",
            "default": 8,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "resolve_max_output_tokens",
            "type": "int",
            "default": 1500,
            "min": 300,
            "max": 8000,
            "scope": "global",
            "unit": "tokens"
        },
        {
            "name": "check_provider",
            "type": "string",
            "default": "anthropic",
            "min": 1,
            "max": 40,
            "scope": "global"
        },
        {
            "name": "check_model",
            "type": "string",
            "default": "claude-haiku-4-5",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "check_input_usd_per_million",
            "type": "float",
            "default": 1,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "check_output_usd_per_million",
            "type": "float",
            "default": 5,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "check_max_output_tokens",
            "type": "int",
            "default": 2000,
            "min": 300,
            "max": 8000,
            "scope": "global",
            "unit": "tokens"
        },
        {
            "name": "resolve_per_run",
            "type": "int",
            "default": 30,
            "min": 1,
            "max": 500,
            "scope": "shop",
            "unit": "searches"
        },
        {
            "name": "resolve_min_searches",
            "type": "int",
            "default": 3,
            "min": 1,
            "max": 1000,
            "scope": "shop",
            "unit": "times"
        },
        {
            "name": "resolve_candidates",
            "type": "int",
            "default": 20,
            "min": 4,
            "max": 60,
            "scope": "global",
            "unit": "results"
        },
        {
            "name": "resolve_days",
            "type": "int",
            "default": 14,
            "min": 1,
            "max": 90,
            "scope": "shop",
            "unit": "days"
        },
        {
            "name": "tags_provider",
            "type": "string",
            "default": "openai",
            "min": 1,
            "max": 40,
            "scope": "global"
        },
        {
            "name": "tags_model",
            "type": "string",
            "default": "gpt-5.4-mini",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "tags_input_usd_per_million",
            "type": "float",
            "default": 1,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "tags_output_usd_per_million",
            "type": "float",
            "default": 8,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "tags_max_output_tokens",
            "type": "int",
            "default": 4000,
            "min": 500,
            "max": 16000,
            "scope": "global",
            "unit": "tokens"
        },
        {
            "name": "tags_per_run",
            "type": "int",
            "default": 150,
            "min": 1,
            "max": 2000,
            "scope": "shop",
            "unit": "pages"
        },
        {
            "name": "tags_per_page",
            "type": "int",
            "default": 5,
            "min": 1,
            "max": 8,
            "scope": "shop",
            "unit": "tags"
        },
        {
            "name": "tags_batch",
            "type": "int",
            "default": 15,
            "min": 1,
            "max": 40,
            "scope": "global",
            "unit": "pages"
        },
        {
            "name": "tags_min_results",
            "type": "int",
            "default": 2,
            "min": 1,
            "max": 20,
            "scope": "global",
            "unit": "results"
        },
        {
            "name": "answers_in_index",
            "type": "int",
            "default": 300,
            "min": 0,
            "max": 3000,
            "scope": "shop",
            "unit": "answers"
        }
    ]
}
