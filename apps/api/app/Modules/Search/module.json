{
    "name": "Search",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Runs",
        "Ai",
        "Connections",
        "Catalog",
        "Retrieval",
        "Admin",
        "Assistant"
    ],
    "provider": "SearchServiceProvider",
    "features": [
        {
            "name": "storefront",
            "default": true
        },
        {
            "name": "semantic",
            "default": true
        },
        {
            "name": "pictures",
            "default": true
        },
        {
            "name": "photos",
            "default": false
        },
        {
            "name": "resolve_empty",
            "default": true
        },
        {
            "name": "page_tags",
            "default": false
        },
        {
            "name": "similar",
            "default": true
        },
        {
            "name": "photo_tags",
            "default": true
        },
        {
            "name": "photo_limits",
            "default": false
        },
        {
            "name": "photo_second_look",
            "default": true
        },
        {
            "name": "photo_log",
            "default": true
        }
    ],
    "settings": [
        {
            "name": "input_selector",
            "type": "string",
            "default": "input[name=\"s\"], input[type=\"search\"]",
            "min": 1,
            "max": 300,
            "scope": "shop"
        },
        {
            "name": "results",
            "type": "enum",
            "options": [
                "panel",
                "page",
                "drawer"
            ],
            "default": "panel",
            "scope": "shop"
        },
        {
            "name": "suggestions",
            "type": "int",
            "default": 6,
            "min": 1,
            "max": 12,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "results_per_group",
            "type": "int",
            "default": 12,
            "min": 1,
            "max": 48,
            "scope": "shop",
            "unit": "results"
        },
        {
            "name": "semantic_results",
            "type": "int",
            "default": 24,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "results"
        },
        {
            "name": "semantic_min_similarity",
            "type": "float",
            "default": 0.3,
            "min": 0,
            "max": 1,
            "scope": "global"
        },
        {
            "name": "picture_min_similarity",
            "type": "float",
            "default": 0.35,
            "min": 0,
            "max": 1,
            "scope": "global"
        },
        {
            "name": "semantic_min_chars",
            "type": "int",
            "default": 3,
            "min": 1,
            "max": 50,
            "scope": "global",
            "unit": "characters"
        },
        {
            "name": "requests_per_minute",
            "type": "int",
            "default": 120,
            "min": 10,
            "max": 5000,
            "scope": "global",
            "unit": "requests"
        },
        {
            "name": "keep_days",
            "type": "int",
            "default": 365,
            "min": 30,
            "max": 1095,
            "scope": "global",
            "unit": "days"
        },
        {
            "name": "photo_max_kb",
            "type": "int",
            "default": 5120,
            "min": 100,
            "max": 20000,
            "scope": "global",
            "unit": "kilobytes"
        },
        {
            "name": "photos_per_day",
            "type": "int",
            "default": 500,
            "min": 0,
            "max": 100000,
            "scope": "shop",
            "unit": "searches"
        },
        {
            "name": "photo_requests_per_minute",
            "type": "int",
            "default": 10,
            "min": 1,
            "max": 600,
            "scope": "global",
            "unit": "requests"
        },
        {
            "name": "photo_min_similarity",
            "type": "float",
            "default": 0.7,
            "min": 0,
            "max": 1,
            "scope": "global"
        },
        {
            "name": "photo_relative_gap",
            "type": "float",
            "default": 0.06,
            "min": 0,
            "max": 1,
            "scope": "global"
        },
        {
            "name": "photo_in_stock_only",
            "type": "bool",
            "default": true,
            "scope": "shop"
        },
        {
            "name": "photo_tags_provider",
            "type": "string",
            "default": "anthropic",
            "min": 1,
            "max": 40,
            "scope": "global"
        },
        {
            "name": "photo_tags_model",
            "type": "string",
            "default": "claude-haiku-4-5",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "photo_tags_input_usd_per_million",
            "type": "float",
            "default": 1,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "photo_tags_output_usd_per_million",
            "type": "float",
            "default": 5,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "photo_tags_max_output_tokens",
            "type": "int",
            "default": 400,
            "min": 100,
            "max": 2000,
            "scope": "global",
            "unit": "tokens"
        },
        {
            "name": "photo_sure_min",
            "type": "float",
            "default": 0.6,
            "min": 0,
            "max": 1,
            "scope": "global"
        },
        {
            "name": "photo_second_provider",
            "type": "string",
            "default": "anthropic",
            "min": 1,
            "max": 40,
            "scope": "global"
        },
        {
            "name": "photo_second_model",
            "type": "string",
            "default": "claude-sonnet-5-5",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "photo_second_input_usd_per_million",
            "type": "float",
            "default": 3,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "photo_second_output_usd_per_million",
            "type": "float",
            "default": 15,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "photo_second_max_output_tokens",
            "type": "int",
            "default": 300,
            "min": 100,
            "max": 2000,
            "scope": "global",
            "unit": "tokens"
        },
        {
            "name": "photo_keep_days",
            "type": "int",
            "default": 7,
            "min": 1,
            "max": 90,
            "scope": "global",
            "unit": "days"
        },
        {
            "name": "resolve_provider",
            "type": "string",
            "default": "openai",
            "min": 1,
            "max": 40,
            "scope": "global"
        },
        {
            "name": "resolve_model",
            "type": "string",
            "default": "gpt-5.4-mini",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "resolve_input_usd_per_million",
            "type": "float",
            "default": 1,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "resolve_output_usd_per_million",
            "type": "float",
            "default": 8,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "resolve_max_output_tokens",
            "type": "int",
            "default": 1500,
            "min": 300,
            "max": 8000,
            "scope": "global",
            "unit": "tokens"
        },
        {
            "name": "check_provider",
            "type": "string",
            "default": "anthropic",
            "min": 1,
            "max": 40,
            "scope": "global"
        },
        {
            "name": "check_model",
            "type": "string",
            "default": "claude-haiku-4-5",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "check_input_usd_per_million",
            "type": "float",
            "default": 1,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "check_output_usd_per_million",
            "type": "float",
            "default": 5,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "check_max_output_tokens",
            "type": "int",
            "default": 2000,
            "min": 300,
            "max": 8000,
            "scope": "global",
            "unit": "tokens"
        },
        {
            "name": "resolve_per_run",
            "type": "int",
            "default": 30,
            "min": 1,
            "max": 500,
            "scope": "shop",
            "unit": "searches"
        },
        {
            "name": "resolve_min_searches",
            "type": "int",
            "default": 3,
            "min": 1,
            "max": 1000,
            "scope": "shop",
            "unit": "times"
        },
        {
            "name": "resolve_candidates",
            "type": "int",
            "default": 20,
            "min": 4,
            "max": 60,
            "scope": "global",
            "unit": "results"
        },
        {
            "name": "resolve_days",
            "type": "int",
            "default": 14,
            "min": 1,
            "max": 90,
            "scope": "shop",
            "unit": "days"
        },
        {
            "name": "tags_provider",
            "type": "string",
            "default": "openai",
            "min": 1,
            "max": 40,
            "scope": "global"
        },
        {
            "name": "tags_model",
            "type": "string",
            "default": "gpt-5.4-mini",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "tags_input_usd_per_million",
            "type": "float",
            "default": 1,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "tags_output_usd_per_million",
            "type": "float",
            "default": 8,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "tags_max_output_tokens",
            "type": "int",
            "default": 4000,
            "min": 500,
            "max": 16000,
            "scope": "global",
            "unit": "tokens"
        },
        {
            "name": "tags_per_run",
            "type": "int",
            "default": 150,
            "min": 1,
            "max": 2000,
            "scope": "shop",
            "unit": "pages"
        },
        {
            "name": "tags_per_page",
            "type": "int",
            "default": 5,
            "min": 1,
            "max": 8,
            "scope": "shop",
            "unit": "tags"
        },
        {
            "name": "tags_batch",
            "type": "int",
            "default": 15,
            "min": 1,
            "max": 40,
            "scope": "global",
            "unit": "pages"
        },
        {
            "name": "tags_min_results",
            "type": "int",
            "default": 2,
            "min": 1,
            "max": 20,
            "scope": "global",
            "unit": "results"
        },
        {
            "name": "answers_in_index",
            "type": "int",
            "default": 300,
            "min": 0,
            "max": 3000,
            "scope": "shop",
            "unit": "answers"
        },
        {
            "name": "drawer_side",
            "type": "enum",
            "options": [
                "start",
                "end"
            ],
            "default": "start",
            "scope": "shop"
        }
    ],
    "agents": [
        {
            "name": "tagger",
            "action": "write_tags",
            "when": "03:30",
            "features": [
                "page_tags"
            ],
            "roles": [
                {
                    "role": "writer",
                    "provider": "tags_provider",
                    "model": "tags_model",
                    "prices": [
                        "tags_input_usd_per_million",
                        "tags_output_usd_per_million"
                    ],
                    "prompts": [
                        "tags"
                    ]
                },
                {
                    "role": "checker",
                    "provider": "check_provider",
                    "model": "check_model",
                    "prices": [
                        "check_input_usd_per_million",
                        "check_output_usd_per_million"
                    ],
                    "prompts": [
                        "tags_check"
                    ]
                }
            ],
            "run": {
                "command": "search",
                "step": "tags",
                "shop_argument": "target"
            }
        },
        {
            "name": "resolver",
            "action": "resolve",
            "when": "04:00",
            "features": [
                "resolve_empty"
            ],
            "roles": [
                {
                    "role": "writer",
                    "provider": "resolve_provider",
                    "model": "resolve_model",
                    "prices": [
                        "resolve_input_usd_per_million",
                        "resolve_output_usd_per_million"
                    ],
                    "prompts": [
                        "resolve"
                    ]
                },
                {
                    "role": "checker",
                    "provider": "check_provider",
                    "model": "check_model",
                    "prices": [
                        "check_input_usd_per_million",
                        "check_output_usd_per_million"
                    ],
                    "prompts": [
                        "resolve_check"
                    ]
                }
            ],
            "run": {
                "command": "search",
                "step": "resolve",
                "shop_argument": "target"
            }
        },
        {
            "name": "photo_reader",
            "action": "read_photo",
            "when": "live",
            "features": [
                "photos",
                "photo_tags"
            ],
            "roles": [
                {
                    "role": "reader",
                    "provider": "photo_tags_provider",
                    "model": "photo_tags_model",
                    "prices": [
                        "photo_tags_input_usd_per_million",
                        "photo_tags_output_usd_per_million"
                    ],
                    "prompts": [
                        "photo_tags"
                    ]
                },
                {
                    "role": "second",
                    "provider": "photo_second_provider",
                    "model": "photo_second_model",
                    "prices": [
                        "photo_second_input_usd_per_million",
                        "photo_second_output_usd_per_million"
                    ],
                    "prompts": [
                        "photo_second_look"
                    ]
                }
            ]
        }
    ]
}
