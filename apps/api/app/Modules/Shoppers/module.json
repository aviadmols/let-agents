{
    "name": "Shoppers",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Connections",
        "Catalog",
        "Analytics",
        "Admin", "Shopify"],
    "provider": "ShoppersServiceProvider",
    "features": [
        {
            "name": "recent_products",
            "default": true
        },
        {
            "name": "signup",
            "default": false
        },
        {
            "name": "callbacks",
            "default": true
        }
    ],
    "settings": [
        {
            "name": "recent_products_count",
            "type": "int",
            "default": 6,
            "min": 1,
            "max": 12,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "recent_days",
            "type": "int",
            "default": 7,
            "min": 1,
            "max": 90,
            "scope": "shop",
            "unit": "days"
        },
        {
            "name": "recent_days_identified",
            "type": "int",
            "default": 90,
            "min": 1,
            "max": 400,
            "scope": "shop",
            "unit": "days"
        },
        {
            "name": "country_code",
            "type": "string",
            "default": "972",
            "min": 1,
            "max": 4,
            "scope": "shop"
        },
        {
            "name": "code_valid_minutes",
            "type": "int",
            "default": 15,
            "min": 2,
            "max": 120,
            "scope": "global",
            "unit": "minutes"
        },
        {
            "name": "code_attempts",
            "type": "int",
            "default": 5,
            "min": 1,
            "max": 10,
            "scope": "global",
            "unit": "attempts"
        },
        {
            "name": "signups_per_visitor_per_day",
            "type": "int",
            "default": 5,
            "min": 1,
            "max": 50,
            "scope": "shop",
            "unit": "sign-ups"
        },
        {
            "name": "signups_per_minute",
            "type": "int",
            "default": 10,
            "min": 1,
            "max": 200,
            "scope": "global",
            "unit": "requests"
        },
        {
            "name": "signup_title",
            "type": "string",
            "default": "",
            "min": 0,
            "max": 120,
            "scope": "shop"
        },
        {
            "name": "signup_consent",
            "type": "string",
            "default": "",
            "min": 0,
            "max": 300,
            "scope": "shop"
        },
        {
            "name": "signup_note",
            "type": "string",
            "default": "",
            "min": 0,
            "max": 160,
            "scope": "shop"
        }
    ]
}
