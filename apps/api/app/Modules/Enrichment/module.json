    "agents": [
        {
            "name": "nightly_model",
            "action": "nightly_model",
            "when": "03:10",
            "features": [],
            "roles": [
                {
                    "role": "reader",
                    "provider": "reader_provider",
                    "model": "reader_model",
                    "prices": [
                        "reader_input_usd_per_million",
                        "reader_output_usd_per_million"
                    ],
                    "prompts": [
                        "product_extraction",
                        "content_mapping",
                        "product_highlights"
                    ]
                },
                {
                    "role": "checker",
                    "provider": "reviewer_provider",
                    "model": "reviewer_model",
                    "prices": [
                        "reviewer_input_usd_per_million",
                        "reviewer_output_usd_per_million"
                    ],
                    "prompts": [
                        "fact_review"
                    ]
                }
            ],
            "run": {
                "command": "enrichment",
                "step": "nightly",
                "shop_argument": "target"
            }
        },
        {
            "name": "auditor",
            "action": "audit_content",
            "when": "weekly",
            "features": [],
            "roles": [
                {
                    "role": "writer",
                    "provider": "audit_writer_provider",
                    "model": "audit_writer_model",
                    "prices": [
                        "audit_writer_input_usd_per_million",
                        "audit_writer_output_usd_per_million"
                    ],
                    "prompts": [
                        "propose_rules"
                    ]
                },
                {
                    "role": "checker",
                    "provider": "audit_checker_provider",
                    "model": "audit_checker_model",
                    "prices": [
                        "audit_checker_input_usd_per_million",
                        "audit_checker_output_usd_per_million"
                    ],
                    "prompts": [
                        "audit_article",
                        "review_rules"
                    ]
                }
            ],
            "run": {
                "command": "enrichment",
                "step": "audit",
                "shop_argument": "target"
            }
        },
        {
            "name": "schema_discovery",
            "action": "discover_schema",
            "when": "on_request",
            "features": [],
            "roles": [
