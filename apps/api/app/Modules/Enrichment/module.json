{
    "name": "Enrichment",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Runs",
        "Catalog",
        "Admin",
        "Ai",
        "Analytics",
        "Retrieval"
    ],
    "provider": "EnrichmentServiceProvider",
    "features": [
        {
            "name": "relations",
            "default": false
        },
        {
            "name": "read_text_in_code",
            "default": false
        },
        {
            "name": "auto_approve",
            "default": true
        },
        {
            "name": "weekly_audit",
            "default": true
        },
        {
            "name": "nightly",
            "default": true
        },
        {
            "name": "auto_publish_rules",
            "default": true
        }
    ],
    "settings": [
        {
            "name": "max_requests_per_task_file",
            "type": "int",
            "default": 400,
            "min": 1,
            "max": 5000,
            "scope": "shop",
            "unit": "requests"
        },
        {
            "name": "max_agent_text_chars",
            "type": "int",
            "default": 1000,
            "min": 300,
            "max": 8000,
            "scope": "shop",
            "unit": "characters"
        },
        {
            "name": "max_highlight_text_chars",
            "type": "int",
            "default": 3000,
            "min": 500,
            "max": 12000,
            "scope": "shop",
            "unit": "characters"
        },
        {
            "name": "max_products_per_article",
            "type": "int",
            "default": 6,
            "min": 1,
            "max": 24,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "min_set_size",
            "type": "int",
            "default": 4,
            "min": 2,
            "max": 50,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "max_upload_kilobytes",
            "type": "int",
            "default": 20000,
            "min": 100,
            "max": 100000,
            "scope": "global",
            "unit": "kilobytes"
        },
        {
            "name": "model_answer_tokens",
            "type": "int",
            "default": 900,
            "min": 200,
            "max": 4000,
            "scope": "shop",
            "unit": "tokens"
        },
        {
            "name": "nightly_model_requests",
            "type": "int",
            "default": 40,
            "min": 0,
            "max": 500,
            "scope": "shop",
            "unit": "requests"
        },
        {
            "name": "copurchase_window_days",
            "type": "int",
            "default": 180,
            "min": 30,
            "max": 730,
            "scope": "shop",
            "unit": "days"
        },
        {
            "name": "copurchase_min_orders",
            "type": "int",
            "default": 3,
            "min": 2,
            "max": 100,
            "scope": "shop",
            "unit": "orders"
        },
        {
            "name": "reader_provider",
            "type": "enum",
            "options": [
                "openai",
                "anthropic",
                "gemini"
            ],
            "default": "openai",
            "scope": "global"
        },
        {
            "name": "reader_model",
            "type": "string",
            "default": "gpt-5.4-nano",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "reader_input_usd_per_million",
            "type": "float",
            "default": 0.3,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "reader_output_usd_per_million",
            "type": "float",
            "default": 2.5,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "audit_writer_provider",
            "type": "enum",
            "options": [
                "openai",
                "anthropic",
                "gemini"
            ],
            "default": "openai",
            "scope": "global"
        },
        {
            "name": "audit_writer_model",
            "type": "string",
            "default": "gpt-5.4-mini",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "audit_writer_input_usd_per_million",
            "type": "float",
            "default": 1.0,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "audit_writer_output_usd_per_million",
            "type": "float",
            "default": 8.0,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "audit_checker_provider",
            "type": "enum",
            "options": [
                "openai",
                "anthropic",
                "gemini"
            ],
            "default": "openai",
            "scope": "global"
        },
        {
            "name": "audit_checker_model",
            "type": "string",
            "default": "gpt-5.4-nano",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "audit_checker_input_usd_per_million",
            "type": "float",
            "default": 0.3,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "audit_checker_output_usd_per_million",
            "type": "float",
            "default": 2.5,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "schema_rounds",
            "type": "int",
            "default": 2,
            "min": 0,
            "max": 3,
            "scope": "global",
            "unit": "rounds"
        },
        {
            "name": "schema_sample",
            "type": "int",
            "default": 300,
            "min": 50,
            "max": 1000,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "schema_writer_provider",
            "type": "enum",
            "options": [
                "openai",
                "anthropic",
                "gemini"
            ],
            "default": "openai",
            "scope": "global"
        },
        {
            "name": "schema_writer_model",
            "type": "string",
            "default": "gpt-5.4-mini",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "schema_writer_input_usd_per_million",
            "type": "float",
            "default": 1.0,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "schema_writer_output_usd_per_million",
            "type": "float",
            "default": 8.0,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "schema_reviewer_provider",
            "type": "enum",
            "options": [
                "openai",
                "anthropic",
                "gemini"
            ],
            "default": "anthropic",
            "scope": "global"
        },
        {
            "name": "schema_reviewer_model",
            "type": "string",
            "default": "claude-sonnet-5-5",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "schema_reviewer_input_usd_per_million",
            "type": "float",
            "default": 3.0,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "schema_reviewer_output_usd_per_million",
            "type": "float",
            "default": 15.0,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        }
    ],
    "agents": [
        {
            "name": "nightly_model",
            "action": "nightly_model",
            "when": "03:10",
            "features": [],
            "roles": [
                {
                    "role": "reader",
                    "provider": "reader_provider",
                    "model": "reader_model",
                    "prices": [
                        "reader_input_usd_per_million",
                        "reader_output_usd_per_million"
                    ],
                    "prompts": [
                        "product_extraction",
                        "fact_review",
                        "content_mapping",
                        "product_highlights"
                    ]
                }
            ],
            "run": {
                "command": "enrichment",
                "step": "nightly",
                "shop_argument": "target"
            }
        },
        {
            "name": "auditor",
            "action": "audit_content",
            "when": "weekly",
            "features": [],
            "roles": [
                {
                    "role": "writer",
                    "provider": "audit_writer_provider",
                    "model": "audit_writer_model",
                    "prices": [
                        "audit_writer_input_usd_per_million",
                        "audit_writer_output_usd_per_million"
                    ],
                    "prompts": [
                        "propose_rules"
                    ]
                },
                {
                    "role": "checker",
                    "provider": "audit_checker_provider",
                    "model": "audit_checker_model",
                    "prices": [
                        "audit_checker_input_usd_per_million",
                        "audit_checker_output_usd_per_million"
                    ],
                    "prompts": [
                        "audit_article",
                        "review_rules"
                    ]
                }
            ],
            "run": {
                "command": "enrichment",
                "step": "audit",
                "shop_argument": "target"
            }
        },
        {
            "name": "schema_discovery",
            "action": "discover_schema",
            "when": "on_request",
            "features": [],
            "roles": [
                {
                    "role": "writer",
                    "provider": "schema_writer_provider",
                    "model": "schema_writer_model",
                    "prices": [
                        "schema_writer_input_usd_per_million",
                        "schema_writer_output_usd_per_million"
                    ],
                    "prompts": [
                        "schema_writer",
                        "schema_revise"
                    ]
                },
                {
                    "role": "checker",
                    "provider": "schema_reviewer_provider",
                    "model": "schema_reviewer_model",
                    "prices": [
                        "schema_reviewer_input_usd_per_million",
                        "schema_reviewer_output_usd_per_million"
                    ],
                    "prompts": [
                        "schema_review"
                    ]
                }
            ],
            "run": {
                "command": "enrichment",
                "step": "schema",
                "shop_argument": "target"
            }
        }
    ]
}
