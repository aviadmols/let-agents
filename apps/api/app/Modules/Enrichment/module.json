{
    "name": "Enrichment",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Runs",
        "Catalog",
        "Admin",
        "Ai",
        "Analytics",
        "Retrieval"
    ],
    "provider": "EnrichmentServiceProvider",
    "features": [
        {
            "name": "auto_approve",
            "default": true
        },
        {
            "name": "weekly_audit",
            "default": true
        },
        {
            "name": "nightly",
            "default": true
        },
        {
            "name": "auto_publish_rules",
            "default": true
        }
    ],
    "settings": [
        {
            "name": "max_requests_per_task_file",
            "type": "int",
            "default": 400,
            "min": 1,
            "max": 5000,
            "scope": "shop",
            "unit": "requests"
        },
        {
            "name": "max_agent_text_chars",
            "type": "int",
            "default": 1000,
            "min": 300,
            "max": 8000,
            "scope": "shop",
            "unit": "characters"
        },
        {
            "name": "max_highlight_text_chars",
            "type": "int",
            "default": 3000,
            "min": 500,
            "max": 12000,
            "scope": "shop",
            "unit": "characters"
        },
        {
            "name": "max_products_per_article",
            "type": "int",
            "default": 6,
            "min": 1,
            "max": 24,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "min_set_size",
            "type": "int",
            "default": 4,
            "min": 2,
            "max": 50,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "max_upload_kilobytes",
            "type": "int",
            "default": 20000,
            "min": 100,
            "max": 100000,
            "scope": "global",
            "unit": "kilobytes"
        },
        {
            "name": "model_answer_tokens",
            "type": "int",
            "default": 900,
            "min": 200,
            "max": 4000,
            "scope": "shop",
            "unit": "tokens"
        },
        {
            "name": "nightly_model_requests",
            "type": "int",
            "default": 40,
            "min": 0,
            "max": 500,
            "scope": "shop",
            "unit": "requests"
        },
        {
            "name": "copurchase_window_days",
            "type": "int",
            "default": 180,
            "min": 30,
            "max": 730,
            "scope": "shop",
            "unit": "days"
        },
        {
            "name": "copurchase_min_orders",
            "type": "int",
            "default": 3,
            "min": 2,
            "max": 100,
            "scope": "shop",
            "unit": "orders"
        }
    ]
}
