{
    "name": "Demo",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Runs",
        "Connections",
        "Catalog",
        "Admin",
        "Ai",
        "Assistant",
        "Search",
        "Retrieval"
    ],
    "provider": "DemoServiceProvider",
    "features": [
        { "name": "enabled", "default": true },
        { "name": "pictures", "default": true }
    ],
    "settings": [
        { "name": "max_products", "type": "int", "default": 300, "min": 10, "max": 2000, "scope": "global", "unit": "products" },
        { "name": "max_content", "type": "int", "default": 100, "min": 0, "max": 500, "scope": "global", "unit": "items" },
        { "name": "keep_days", "type": "int", "default": 7, "min": 1, "max": 60, "scope": "global", "unit": "days" },
        { "name": "per_day", "type": "int", "default": 20, "min": 0, "max": 500, "scope": "global", "unit": "items" },
        { "name": "per_email_per_day", "type": "int", "default": 3, "min": 1, "max": 50, "scope": "global", "unit": "items" },
        { "name": "budget_usd", "type": "float", "default": 4, "min": 0.2, "max": 20, "scope": "global", "unit": "usd" },
        { "name": "questions", "type": "int", "default": 15, "min": 0, "max": 200, "scope": "global", "unit": "questions" },
        { "name": "photos", "type": "int", "default": 30, "min": 0, "max": 500, "scope": "global", "unit": "items" },
        { "name": "prepared_questions", "type": "int", "default": 5, "min": 0, "max": 20, "scope": "global", "unit": "questions" },
        { "name": "vocabulary_branches", "type": "int", "default": 4, "min": 1, "max": 12, "scope": "global", "unit": "items" }
    ]
}
