{
    "name": "Recovery",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Runs",
        "Ai",
        "Connections",
        "Catalog",
        "Analytics",
        "Admin"
    ],
    "provider": "RecoveryServiceProvider",
    "features": [
        {
            "name": "capture",
            "default": false
        },
        {
            "name": "report",
            "default": true
        }
    ],
    "settings": [
        {
            "name": "wait_minutes",
            "type": "int",
            "default": 60,
            "min": 10,
            "max": 1440,
            "scope": "shop",
            "unit": "minutes"
        },
        {
            "name": "keep_days",
            "type": "int",
            "default": 90,
            "min": 7,
            "max": 365,
            "scope": "global",
            "unit": "days"
        },
        {
            "name": "reports_per_run",
            "type": "int",
            "default": 50,
            "min": 1,
            "max": 500,
            "scope": "global"
        },
        {
            "name": "popup_title",
            "type": "string",
            "default": "",
            "min": 0,
            "max": 80,
            "scope": "shop"
        },
        {
            "name": "popup_text",
            "type": "string",
            "default": "",
            "min": 0,
            "max": 200,
            "scope": "shop"
        },
        {
            "name": "popup_button",
            "type": "string",
            "default": "",
            "min": 0,
            "max": 40,
            "scope": "shop"
        },
        {
            "name": "popup_skip",
            "type": "string",
            "default": "",
            "min": 0,
            "max": 40,
            "scope": "shop"
        },
        {
            "name": "popup_consent",
            "type": "string",
            "default": "",
            "min": 0,
            "max": 400,
            "scope": "shop"
        },
        {
            "name": "writer_provider",
            "type": "string",
            "default": "anthropic",
            "min": 1,
            "max": 40,
            "scope": "global"
        },
        {
            "name": "writer_model",
            "type": "string",
            "default": "claude-sonnet-5-5",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "writer_input_usd_per_million",
            "type": "float",
            "default": 3.0,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "writer_output_usd_per_million",
            "type": "float",
            "default": 15.0,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "writer_max_output_tokens",
            "type": "int",
            "default": 600,
            "min": 200,
            "max": 4000,
            "scope": "global",
            "unit": "tokens"
        },
        {
            "name": "checker_provider",
            "type": "string",
            "default": "openai",
            "min": 1,
            "max": 40,
            "scope": "global"
        },
        {
            "name": "checker_model",
            "type": "string",
            "default": "gpt-5.4-nano",
            "min": 1,
            "max": 120,
            "scope": "global"
        },
        {
            "name": "checker_input_usd_per_million",
            "type": "float",
            "default": 0.05,
            "min": 0,
            "max": 100,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "checker_output_usd_per_million",
            "type": "float",
            "default": 0.4,
            "min": 0,
            "max": 400,
            "scope": "global",
            "unit": "usd"
        },
        {
            "name": "checker_max_output_tokens",
            "type": "int",
            "default": 300,
            "min": 100,
            "max": 2000,
            "scope": "global",
            "unit": "tokens"
        }
    ],
    "agents": [
        {
            "name": "reporter",
            "action": "report",
            "when": "hourly",
            "features": [
                "report"
            ],
            "roles": [
                {
                    "role": "writer",
                    "provider": "writer_provider",
                    "model": "writer_model",
                    "prices": [
                        "writer_input_usd_per_million",
                        "writer_output_usd_per_million"
                    ],
                    "prompts": [
                        "report"
                    ]
                },
                {
                    "role": "checker",
                    "provider": "checker_provider",
                    "model": "checker_model",
                    "prices": [
                        "checker_input_usd_per_million",
                        "checker_output_usd_per_million"
                    ],
                    "prompts": [
                        "check"
                    ]
                }
            ],
            "run": {
                "command": "recovery:report",
                "shop_argument": "shop"
            }
        }
    ]
}
