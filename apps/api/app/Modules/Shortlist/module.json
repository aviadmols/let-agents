{
    "name": "Shortlist",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Connections",
        "Catalog",
        "Enrichment",
        "Admin",
        "Shopify"
    ],
    "provider": "ShortlistServiceProvider",
    "features": [
        {
            "name": "compare",
            "default": false
        },
        {
            "name": "wishlist",
            "default": false
        }
    ],
    "settings": [
        {
            "name": "compare_max",
            "type": "int",
            "default": 5,
            "min": 2,
            "max": 5,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "wishlist_max",
            "type": "int",
            "default": 100,
            "min": 10,
            "max": 200,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "card_selector",
            "type": "string",
            "default": "",
            "min": 0,
            "max": 300,
            "scope": "shop"
        },
        {
            "name": "product_selector",
            "type": "string",
            "default": "form[action*=\"/cart/add\"], form.cart",
            "min": 0,
            "max": 300,
            "scope": "shop"
        },
        {
            "name": "requests_per_minute",
            "type": "int",
            "default": 60,
            "min": 10,
            "max": 600,
            "scope": "global",
            "unit": "requests"
        }
    ]
}
