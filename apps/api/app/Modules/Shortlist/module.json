{
    "name": "Shortlist",
    "enabled": true,
    "requires": [
        "Tenancy",
        "Connections",
        "Catalog",
        "Enrichment",
        "Admin",
        "Shopify",
        "Sms"
    ],
    "provider": "ShortlistServiceProvider",
    "features": [
        {
            "name": "compare",
            "default": false
        },
        {
            "name": "wishlist",
            "default": false
        },
        {
            "name": "wishlist_phone",
            "default": false
        }
    ],
    "settings": [
        {
            "name": "compare_max",
            "type": "int",
            "default": 5,
            "min": 2,
            "max": 5,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "wishlist_max",
            "type": "int",
            "default": 100,
            "min": 10,
            "max": 200,
            "scope": "shop",
            "unit": "products"
        },
        {
            "name": "wishlist_whatsapp",
            "type": "bool",
            "default": true,
            "scope": "shop"
        },
        {
            "name": "requests_per_minute",
            "type": "int",
            "default": 60,
            "min": 10,
            "max": 600,
            "scope": "global",
            "unit": "requests"
        },
        {
            "name": "phone_codes_per_hour",
            "type": "int",
            "default": 3,
            "min": 1,
            "max": 10,
            "scope": "global",
            "unit": "items"
        },
        {
            "name": "phone_codes_per_ip_hour",
            "type": "int",
            "default": 10,
            "min": 1,
            "max": 50,
            "scope": "global",
            "unit": "items"
        },
        {
            "name": "phone_codes_per_day",
            "type": "int",
            "default": 300,
            "min": 0,
            "max": 5000,
            "scope": "shop",
            "unit": "items"
        },
        {
            "name": "visit_keep_days",
            "type": "int",
            "default": 90,
            "min": 1,
            "max": 365,
            "scope": "global",
            "unit": "days"
        }
    ]
}
