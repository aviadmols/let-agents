APP_NAME="Let Agents"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Laravel's own fallback. Admin users get he/en per user; see config/upsell.php.
APP_LOCALE=he
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development runs on SQLite. Staging and production run on Postgres with pgvector:
# DB_CONNECTION=pgsql
# DB_URL=${{Postgres.DATABASE_URL}}
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Production: QUEUE_CONNECTION=redis, CACHE_STORE=redis, REDIS_URL=${{Redis.REDIS_URL}}
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Octane (web role only)
OCTANE_SERVER=frankenphp

# Container role on Railway: web | worker | scheduler
APP_ROLE=web
# Set to true on the web service only
RUN_MIGRATIONS=false
